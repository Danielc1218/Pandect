# Copy to .env.local. The first two values are publishable and safe for the browser.

# Hosted project: find these under Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://dzzaehpebcpxqbbmybes.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local Supabase (npx supabase start), for working offline. These are the CLI's fixed demo values.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_... (printed by npx supabase start)

# Server only, never NEXT_PUBLIC_. lib/bank.ts reads the shared question bank with this key so the reads
# can be cached for everyone. Project Settings > API keys > Secret keys.
SUPABASE_SECRET_KEY=
# Any long random string, shared with the import script, which calls /api/revalidate after an import.
REVALIDATE_SECRET=
