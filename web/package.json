{
  "name": "lsat-prep-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test lib/*.test.mjs",
    "design": "if [ -d ../design/mock ]; then mkdir -p app/design && cp ../design/mock/tokens.css ../design/mock/mock.css app/design/ && sed 's/^:root {/:root[data-theme=dark] {/' ../design/mock/themes/dark.css > app/design/dark.css; fi",
    "predev": "npm run design",
    "prebuild": "npm run design"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  }
}
